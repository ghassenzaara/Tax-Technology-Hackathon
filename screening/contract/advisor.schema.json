{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "advisor.schema.json",
  "title": "Advisor",
  "description": "Steuerberater. Read state is stored per advisor, never on the law change.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "salutation": { "type": "string" },
    "title": { "type": "string" },
    "firm": { "type": "string" },
    "seenLawChangeIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
  }
}
