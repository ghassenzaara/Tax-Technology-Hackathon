{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match.schema.json",
  "title": "Match",
  "description": "One record per company and law change. The assessment part is written only by screening, the review part only by the app. A rerun refreshes the assessment and never touches the review.",
  "type": "object",
  "required": ["id", "companyId", "lawChangeId", "assessment", "review"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "companyId": { "$ref": "common.schema.json#/$defs/id" },
    "lawChangeId": { "$ref": "common.schema.json#/$defs/id" },
    "assessment": {
      "type": "object",
      "required": ["score", "confidence", "reason", "evidence", "lawVersion", "screenedAt", "runId"],
      "properties": {
        "score": { "description": "Max cosine similarity.", "type": "number", "minimum": -1, "maximum": 1 },
        "confidence": { "description": "LLM judge confidence.", "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "description": "German explanation.", "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["factLabel", "sectionRef"],
            "properties": {
              "factId": { "$ref": "common.schema.json#/$defs/id" },
              "factLabel": { "type": "string" },
              "sectionRef": { "type": "string" },
              "similarity": { "type": "number" }
            }
          }
        },
        "lawVersion": { "type": "integer", "minimum": 1 },
        "screenedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "runId": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "review": {
      "type": "object",
      "required": ["label", "emailStatus"],
      "properties": {
        "label": { "description": "Known: unlabeled, relevant, irrelevant.", "type": "string" },
        "emailStatus": { "description": "Known: not_sent, sent, discussed.", "type": "string" },
        "notes": { "type": "string" },
        "sentAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "outreachId": { "$ref": "common.schema.json#/$defs/id" },
        "discussedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "updatedBy": { "$ref": "common.schema.json#/$defs/id" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
      }
    }
  }
}
