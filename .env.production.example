# Copy to .env on the server (same folder as compose.prod.yml) and fill in. Never commit .env.

# Domain served by Caddy (www redirects to it).
KLARIS_DOMAIN=justklaris.com

# Login gate. Create the hash on the server:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'YOUR-PASSWORD'
# Keep the single quotes: the hash contains $ signs.
KLARIS_USER=steuerberater
KLARIS_PASSWORD_HASH='paste-hash-here'

# Database password, letters and digits only (it is part of a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Backend settings (see backend/.env.example for every option).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Mail: log writes JSON files only; smtp sends through Gmail.
MAIL_MODE=log
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_REDIRECT_TO=
SENDER_NAME=TODO: Name des Steuerberaters
SENDER_FIRM=TODO: Name der Kanzlei
