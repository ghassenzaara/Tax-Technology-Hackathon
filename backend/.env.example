# Copy to .env and fill in. Empty values fall back to the defaults in app/config.py.

# Needed for scanned PDF pages (GPT vision), extraction and embeddings (step 9).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_S=120

# Placeholders, to be tuned on real documents.
SCAN_MIN_CHARS=50
OCR_DPI=200
PARSE_CONCURRENCY=5
OCR_CONCURRENCY=5
OCR_MAX_ATTEMPTS=4
OCR_BACKOFF_MIN_S=1
OCR_BACKOFF_MAX_S=30
MAX_FILE_MB=50
OCR_PAGE_CAP=30
EXCEL_ROW_CAP=2000

# Uploads live below this folder; step 10 deletes files only inside it.
DATA_DIR=data

# Extraction agents (steps 5 to 7). Empty values use app/profile/profil_schema.json and db_scheme/.
PROFILE_SCHEMA_PATH=
PROFILE_DB_DIR=
AGENT_CONCURRENCY=5
AGENT_MAX_ATTEMPTS=4
AGENT_BACKOFF_MIN_S=1
AGENT_BACKOFF_MAX_S=30
EXTRACTION_REASONING_EFFORT=low
MIN_EXTRACTABLE_CHARS=20
CHARS_PER_TOKEN=3.5
CHUNK_TRIGGER_TOKENS=200000
CHUNK_TARGET_TOKENS=120000
CHUNK_OVERLAP_PAGES=1
EVIDENCE_MAX_CHARS=300
CONFIDENCE_HIGH=0.9
CONFIDENCE_MEDIUM=0.6
CONFIDENCE_LOW=0.3
CONFIDENCE_OCR_CAP=0.7
CONFIDENCE_UNVERIFIED_CAP=0.3
KONFIDENZ_HOCH_MIN=0.8
KONFIDENZ_MITTEL_MIN=0.5
ROUNDING_MAX_GRANULARITY=1000

# Step 9 (embeddings). Placeholders: verify the model id and its dimension.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
SENTENCE_MAX_WORDS=40
SENTENCE_MAX_CHARS=400
SENTENCE_REASONING_EFFORT=low
EMBED_CONCURRENCY=5
# JSON, statute -> tax types for the filter metadata; empty uses the default in config.py.
STATUTE_TAX_TYPES=
# Busy marker of a running step (confirm, embed, cleanup) older than this is taken over.
STEP_LOCK_TIMEOUT_S=3600

# Database: memory (default) or postgres. Local Docker: docker compose up -d, then
# DATABASE_URL=postgresql://dd:dd@localhost:5432/dd. Supabase: direct or session string.
REPOSITORY=memory
DATABASE_URL=
DB_WRITE_ATTEMPTS=3

# Single-user platform: the label the HTTP API stamps as bestaetigt_von and in the audit log.
ADVISOR_LABEL=Steuerberater

# HTTP API and upload layer (step 0). Start: uv run python -m app.api
# TODO: hosting outside local development; the UI team's dev URL (JSON list).
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
# Placeholders, to be tuned. The per-file limit is MAX_FILE_MB above.
UPLOAD_MAX_TOTAL_MB=500
UPLOAD_MAX_FILES=300
UPLOAD_MAX_PATH_CHARS=240
UPLOAD_MAX_PATH_DEPTH=8
UPLOAD_CHUNK_BYTES=1048576
# Global cap on simultaneous runs; later uploads wait as queued.
MAX_ACTIVE_RUNS=2
